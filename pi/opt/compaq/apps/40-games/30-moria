#!/bin/bash
# title: Moria (1983 dungeon adventure)
. /opt/compaq/lib/common.sh
intro "Moria" \
  "Move with the number keys: 8 up, 2 down, 4 left, 6 right, 7 9 1 3 for" \
  "diagonals. ? lists every command. Ctrl-X saves and quits." \
  "Descend to the bottom of the mines and defeat the Balrog." || exit 0
mkdir -p "$FILES/saves" && cd "$FILES/saves" || exit 1
exec /usr/games/moria
