#!/bin/bash
# title: More games: Tetris, Go, Sudoku, typing race and more
. /opt/compaq/lib/common.sh
echo
echo "  MORE GAMES"
picked=$(choose /opt/compaq/data/more-games.list) || exit 0
command=${picked%%|*}
tip=${picked#*|}
read -ra parts <<< "$command"
clear
intro "${parts[0]}" "$tip" || exit 0
mkdir -p "$FILES/saves" && cd "$FILES/saves" || exit 1
"${parts[@]}"
pause
